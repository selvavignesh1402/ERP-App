    "@playwright/test": "^1.62.1",
    "@types/react": "~19.3.0",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.3.3"
  },
  "private": true

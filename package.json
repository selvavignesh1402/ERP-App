{
  "name": "rice-erp",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint:hooks": "eslint app src",
    "format": "prettier --write app src",
    "format:check": "prettier --check app src",
    "test": "node --test tests/*.test.cjs",

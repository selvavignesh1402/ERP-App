# Backend URL override, used first on BOTH web and native.
# Development: leave empty for local web / Expo-host / emulator defaults,
# or set the address reachable from your device, e.g. http://192.168.1.10:8083.
EXPO_PUBLIC_API_URL=
# Production: REQUIRED at build/export time, e.g. https://api.your-company.example.
# Use your real backend address, not localhost or your development machine.
# Expo embeds EXPO_PUBLIC_* values in the app. Never put credentials here.
# Restart Metro after editing; rebuild/export production apps after changes.

# Firebase client web API key from your project's Firebase app settings.
# Optional for non-Firebase login; required before calling Firebase phone auth.
# This public client value is embedded in the app. Never use a service-account key.
EXPO_PUBLIC_FIREBASE_API_KEY=
